{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "title": "抖音热榜 - results 元素",
    "description": "热榜成功时 results 数组中的一条。整份 stdout 见 output_envelope.schema.json，成功时 metadata.total 等于条数。",
    "required": [
        "id",
        "word",
        "event_time",
        "hot_value",
        "position",
        "view_count",
        "event_time_format"
    ],
    "properties": {
        "id": {
            "type": "number",
            "description": "自增ID"
        },
        "word": {
            "type": "string",
            "description": "热榜关键词"
        },
        "event_time": {
            "type": "number",
            "description": "事件发生时间，unix 秒"
        },
        "hot_value": {
            "type": "number",
            "description": "热榜值"
        },
        "position": {
            "type": "number",
            "description": "热榜排名"
        },
        "view_count": {
            "type": "number",
            "description": "关键词的搜索量"
        },
        "event_time_format": {
            "type": "string",
            "description": "事件时间，格式如 2006-01-02 15:04:05"
        }
    }
}