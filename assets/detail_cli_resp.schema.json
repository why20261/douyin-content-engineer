{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "title": "抖音作品详情 - results 对象",
    "description": "作品详情成功时的 results。空字符串和数字 0 可能不返回。图文通常不返回 play_count 和 duration。整份 stdout 见 output_envelope.schema.json。dynamic_cover 是字符串。",
    "properties": {
        "aweme_id": {
            "type": "string",
            "description": "抖音视频ID"
        },
        "desc": {
            "type": "string",
            "description": "抖音视频描述"
        },
        "caption": {
            "type": "string",
            "description": "抖音视频标题"
        },
        "duration": {
            "type": "number",
            "description": "抖音视频时长"
        },
        "ip_attribution": {
            "type": "string",
            "description": "IP 归属地"
        },
        "url": {
            "type": "string",
            "description": "抖音视频URL"
        },
        "tags": {
            "type": "array",
            "description": "抖音视频标签",
            "items": {
                "type": "string",
                "description": "抖音视频标签"
            }
        },
        "suggest_words": {
            "type": "array",
            "description": "抖音视频小蓝词",
            "items": {
                "type": "string",
                "description": "抖音视频小蓝词"
            }
        },
        "comment_count": {
            "type": "number",
            "description": "抖音视频评论数"
        },
        "digg_count": {
            "type": "number",
            "description": "抖音视频点赞数"
        },
        "share_count": {
            "type": "number",
            "description": "抖音视频分享数"
        },
        "collect_count": {
            "type": "number",
            "description": "抖音视频收藏数"
        },
        "play_count": {
            "type": "number",
            "description": "播放数"
        },
        "forward_count": {
            "type": "number",
            "description": "转发数"
        },
        "recommend_count": {
            "type": "number",
            "description": "交互界面未显示字段"
        },
        "dynamic_cover": {
            "type": "string",
            "description": "抖音视频动态封面 URL"
        },
        "play_addr": {
            "type": "string",
            "description": "视频播放地址、视频下载地址"
        },
        "play_uri": {
            "type": "string",
            "description": "抖音视频播放URI"
        },
        "author_id": {
            "type": "string",
            "description": "视频作者用户ID"
        },
        "author_uid": {
            "type": "string",
            "description": "视频作者抖音ID"
        },
        "author_nickname": {
            "type": "string",
            "description": "视频作者抖音昵称"
        },
        "author_avatar": {
            "type": "string",
            "description": "视频作者抖音头像"
        },
        "author_sec_uid": {
            "type": "string",
            "description": "视频作者抖音SEC_UID"
        },
        "author_signature": {
            "type": "string",
            "description": "视频作者抖音签名"
        },
        "author_url": {
            "type": "string",
            "description": "作者主页 URL。有 author_sec_uid 时由技能补上"
        },
        "music_id": {
            "type": "string",
            "description": "抖音视频音乐ID"
        },
        "music_title": {
            "type": "string",
            "description": "抖音视频音乐标题"
        },
        "music_author": {
            "type": "string",
            "description": "抖音视频音乐作者"
        },
        "cha_list": {
            "type": "array",
            "description": "话题列表",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "话题 ID"
                    },
                    "name": {
                        "type": "string",
                        "description": "话题名称"
                    },
                    "desc": {
                        "type": "string",
                        "description": "话题描述"
                    }
                }
            }
        }
    }
}
